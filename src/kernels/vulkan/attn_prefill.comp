#version 450

// Flash attention for the multi-row prefill path. The query tile and K/V tiles
// are generated for head_dimension 64 (64x64) and 128 (32x32); both variants
// stage fp16 K/V in shared memory and evaluate the mask inline.

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer query_blob
{
    vec4 query_data[];
};
#if NCNN_fp16_storage || NCNN_bf16_storage
layout(binding = 1) readonly buffer key_blob
{
    uvec2 key_data[];
};
layout(binding = 2) readonly buffer value_blob
{
    uvec2 value_data[];
};
#else
layout(binding = 1) readonly buffer key_blob
{
    vec4 key_data[];
};
layout(binding = 2) readonly buffer value_blob
{
    vec4 value_data[];
};
#endif
layout(binding = 3) writeonly buffer output_blob
{
    float output_data[];
};

layout(push_constant) uniform parameter
{
    uint query_count;
    uint destination_count;
    uint head_count;
    uint key_value_head_count;
    uint query_cstep;
    uint key_cstep;
    uint value_cstep;
    uint output_columns;
    uint position_offset;
    uint cache_start;
    uint sliding_window;
    float scale;
}
p;

#ifndef ATTN_D
#define ATTN_D 64u
#endif
#ifndef ATTN_M
#define ATTN_M 64u
#endif
#ifndef ATTN_N
#define ATTN_N 64u
#endif
#ifndef ATTN_ROWS
#define ATTN_ROWS 8u
#endif
const uint D = ATTN_D;
const uint M = ATTN_M;
const uint N = ATTN_N;
const uint ROWS = ATTN_ROWS;
const uint PAIRS = D / 2u;
const uint KEYS = N / 32u;
const uint VALUE_PAIRS = PAIRS / 32u;
const uint WORDS = D / 4u;

shared uint shared_query[M * PAIRS];
shared uint shared_key[PAIRS * N];
shared uint shared_value[N * PAIRS];
shared float shared_weights[8u * N];

void load_tile(uint key_base, uint value_base, uint key_offset)
{
    for (uint index = gl_LocalInvocationIndex; index < N * WORDS; index += 256u)
    {
        const uint row = index / WORDS;
        const uint column = index % WORDS;
        const uint global_key = key_offset + row;
        const uint safe_key = min(global_key, p.destination_count - 1u);
        const uint key_index = (key_base + safe_key * D + column * 4u) / 4u;
        const uint value_index = (value_base + safe_key * D + column * 4u) / 4u;
#if NCNN_fp16_storage
        const uvec2 key_pair = key_data[key_index];
        const uvec2 value_pair = value_data[value_index];
        vec4 key = vec4(unpackHalf2x16(key_pair.x), unpackHalf2x16(key_pair.y));
        vec4 value = vec4(unpackHalf2x16(value_pair.x), unpackHalf2x16(value_pair.y));
#elif NCNN_bf16_storage
        const uvec2 key_pair = key_data[key_index];
        const uvec2 value_pair = value_data[value_index];
        vec4 key = vec4(unpackBFloat2x16(key_pair.x), unpackBFloat2x16(key_pair.y));
        vec4 value = vec4(unpackBFloat2x16(value_pair.x), unpackBFloat2x16(value_pair.y));
#else
        vec4 key = key_data[key_index];
        vec4 value = value_data[value_index];
#endif
        if (global_key >= p.destination_count)
        {
            key = vec4(0.0);
            value = vec4(0.0);
        }
        shared_key[(column * 2u) * N + row] = packHalf2x16(key.xy);
        shared_key[(column * 2u + 1u) * N + row] = packHalf2x16(key.zw);
        shared_value[row * PAIRS + column * 2u] = packHalf2x16(value.xy);
        shared_value[row * PAIRS + column * 2u + 1u] = packHalf2x16(value.zw);
    }
}

void main()
{
    const uint lane = gl_SubgroupInvocationID;
    const uint subgroup = gl_SubgroupID;
    const uint head = gl_WorkGroupID.y;
    const uint query_base_row = gl_WorkGroupID.x * M;
    if (head >= p.head_count || lane >= 32u)
        return;

    const uint heads_per_group = p.head_count / p.key_value_head_count;
    const uint key_value_head = head / heads_per_group;
    const uint query_base = head * p.query_cstep;
    const uint key_base = key_value_head * p.key_cstep;
    const uint value_base = key_value_head * p.value_cstep;

    for (uint index = gl_LocalInvocationIndex; index < M * WORDS; index += 256u)
    {
        const uint row = index / WORDS;
        const uint column = index % WORDS;
        const uint global_row = query_base_row + row;
        vec4 query = vec4(0.0);
        if (global_row < p.query_count)
            query = query_data[query_base / 4u + (global_row * D + column * 4u) / 4u];
        shared_query[row * PAIRS + column * 2u] = packHalf2x16(query.xy);
        shared_query[row * PAIRS + column * 2u + 1u] = packHalf2x16(query.zw);
    }
    barrier();

    float acc_even[ROWS * VALUE_PAIRS];
    float acc_odd[ROWS * VALUE_PAIRS];
    float running_max[ROWS];
    float running_sum[ROWS];
    [[unroll]] for (uint r = 0u; r < ROWS; ++r)
    {
        running_max[r] = -3.402823466e+38;
        running_sum[r] = 0.0;
    }
    [[unroll]] for (uint index = 0u; index < ROWS * VALUE_PAIRS; ++index)
    {
        acc_even[index] = 0.0;
        acc_odd[index] = 0.0;
    }

    const uint last_query_row = min(query_base_row + M, p.query_count);
    const uint query_maximum_position = p.position_offset + last_query_row - 1u;
    const uint query_minimum_position = p.position_offset + query_base_row;

    for (uint key_offset = 0u; key_offset < p.destination_count; key_offset += N)
    {
        const uint first_key_position = p.cache_start + key_offset;
        if (first_key_position > query_maximum_position)
            break;
        const uint last_key_position = p.cache_start + key_offset + N - 1u;
        if (p.sliding_window != 0u && last_key_position + p.sliding_window <= query_minimum_position)
            continue;

        load_tile(key_base, value_base, key_offset);
        barrier();

        [[unroll]] for (uint r = 0u; r < ROWS; ++r)
        {
            const uint row = subgroup * ROWS + r;
            const uint global_row = query_base_row + row;
            const uint query_position = p.position_offset + global_row;
            const bool row_valid = global_row < p.query_count;

            float score[KEYS];
            [[unroll]] for (uint k = 0u; k < KEYS; ++k)
            {
                const uint key_index = lane + 32u * k;
                float value = 0.0;
                [[unroll]] for (uint pair = 0u; pair < PAIRS; ++pair)
                {
                    const vec2 query = unpackHalf2x16(shared_query[row * PAIRS + pair]);
                    const vec2 key = unpackHalf2x16(shared_key[pair * N + key_index]);
                    value += dot(query, key);
                }
                const uint key_position = p.cache_start + key_offset + key_index;
                const bool masked = !row_valid || key_offset + key_index >= p.destination_count
                                    || key_position > query_position
                                    || (p.sliding_window != 0u && key_position + p.sliding_window <= query_position);
                score[k] = masked ? -3.402823466e+38 : value * p.scale;
            }

            float tile_maximum = score[0];
            [[unroll]] for (uint k = 1u; k < KEYS; ++k)
                tile_maximum = max(tile_maximum, score[k]);
            tile_maximum = subgroupMax(tile_maximum);
            const float next_maximum = max(running_max[r], tile_maximum);
            const float correction = running_sum[r] == 0.0 ? 0.0 : exp(running_max[r] - next_maximum);
            float tile_sum = 0.0;
            [[unroll]] for (uint k = 0u; k < KEYS; ++k)
            {
                const float weight = score[k] == -3.402823466e+38 ? 0.0 : exp(score[k] - next_maximum);
                shared_weights[subgroup * N + lane + 32u * k] = weight;
                tile_sum += weight;
            }
            running_sum[r] = running_sum[r] * correction + subgroupAdd(tile_sum);
            running_max[r] = next_maximum;
            [[unroll]] for (uint pair = 0u; pair < VALUE_PAIRS; ++pair)
            {
                acc_even[r * VALUE_PAIRS + pair] *= correction;
                acc_odd[r * VALUE_PAIRS + pair] *= correction;
            }
            barrier();

            [[unroll]] for (uint index = 0u; index < N; ++index)
            {
                const float weight = shared_weights[subgroup * N + index];
                [[unroll]] for (uint pair = 0u; pair < VALUE_PAIRS; ++pair)
                {
                    const uint pair_index = lane + 32u * pair;
                    const vec2 value = unpackHalf2x16(shared_value[index * PAIRS + pair_index]);
                    acc_even[r * VALUE_PAIRS + pair] += weight * value.x;
                    acc_odd[r * VALUE_PAIRS + pair] += weight * value.y;
                }
            }
            barrier();
        }
        barrier();
    }

    [[unroll]] for (uint r = 0u; r < ROWS; ++r)
    {
        const uint row = subgroup * ROWS + r;
        const uint global_row = query_base_row + row;
        if (global_row >= p.query_count)
            continue;
        const float inverse = running_sum[r] > 0.0 ? 1.0 / running_sum[r] : 0.0;
        [[unroll]] for (uint pair = 0u; pair < VALUE_PAIRS; ++pair)
        {
            const uint pair_index = lane + 32u * pair;
            const uint base = global_row * p.output_columns + head * D + pair_index * 2u;
            output_data[base] = acc_even[r * VALUE_PAIRS + pair] * inverse;
            output_data[base + 1u] = acc_odd[r * VALUE_PAIRS + pair] * inverse;
        }
    }
}
