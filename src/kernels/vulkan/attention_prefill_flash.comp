#version 450

// Flash attention for the multi-row (prefill) path.
//
// Keep a row tile of queries resident and stream K/V tiles through fp16 shared
// memory, computing the causal mask in the shader instead of reading a
// materialized mask plane.  This kernel does the same for head_dimension 64:
// one workgroup owns a 64-row query tile of a single head, eight subgroups
// each drive eight rows, and every K/V tile is loaded once into fp16 shared
// memory for all rows of the tile.
//
// Q/K/V arrive as fp32 (as produced by the fused QKV+RoPE shader) and are
// rounded to fp16 in shared memory; dot products and the softmax accumulator
// stay fp32, matching the numeric class used by the f16 KV cache.
// The additive attention mask, causal bounds and the sliding window are
// evaluated per score, so no mask upload is needed.

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer query_blob
{
    vec4 query_data[];
};
#if NCNN_fp16_storage || NCNN_bf16_storage
layout(binding = 1) readonly buffer key_blob
{
    uvec2 key_data[];
};
layout(binding = 2) readonly buffer value_blob
{
    uvec2 value_data[];
};
#else
layout(binding = 1) readonly buffer key_blob
{
    vec4 key_data[];
};
layout(binding = 2) readonly buffer value_blob
{
    vec4 value_data[];
};
#endif
layout(binding = 3) writeonly buffer output_blob
{
    float output_data[];
};

layout(push_constant) uniform parameter
{
    uint query_count;
    uint destination_count;
    uint head_count;
    uint key_value_head_count;
    uint query_cstep;
    uint key_cstep;
    uint value_cstep;
    uint output_columns;
    uint position_offset;
    uint cache_start;
    uint sliding_window;
    float scale;
}
p;

const uint D = 64u;
const uint M = 64u;
const uint N = 64u;
const uint ROWS = 8u;
const uint PAIRS = D / 2u;

shared uint shared_query[M * PAIRS];
shared uint shared_key[PAIRS * N];
shared uint shared_value[N * PAIRS];
shared float shared_weights[8u * N];

void load_tile(uint key_base, uint value_base, uint key_offset)
{
    // 16 vec4 rows per key for head_dimension 64.
    for (uint index = gl_LocalInvocationIndex; index < N * 16u; index += 256u)
    {
        const uint row = index / 16u;
        const uint column = index % 16u;
        const uint global_key = key_offset + row;
        const uint safe_key = min(global_key, p.destination_count - 1u);
        const uint key_index = key_base + safe_key * D + column * 4u;
        const uint value_index = value_base + safe_key * D + column * 4u;
#if NCNN_fp16_storage
        const uvec2 key_word = key_data[key_index / 4u];
        const uvec2 value_word = value_data[value_index / 4u];
        vec4 key = vec4(unpackHalf2x16(key_word.x), unpackHalf2x16(key_word.y));
        vec4 value = vec4(unpackHalf2x16(value_word.x), unpackHalf2x16(value_word.y));
#elif NCNN_bf16_storage
        const uvec2 key_word = key_data[key_index / 4u];
        const uvec2 value_word = value_data[value_index / 4u];
        vec4 key = vec4(unpackBFloat2x16(key_word.x), unpackBFloat2x16(key_word.y));
        vec4 value = vec4(unpackBFloat2x16(value_word.x), unpackBFloat2x16(value_word.y));
#else
        vec4 key = key_data[key_index / 4u];
        vec4 value = value_data[value_index / 4u];
#endif
        if (global_key >= p.destination_count)
        {
            key = vec4(0.0);
            value = vec4(0.0);
        }
        shared_key[(column * 2u) * N + row] = packHalf2x16(key.xy);
        shared_key[(column * 2u + 1u) * N + row] = packHalf2x16(key.zw);
        shared_value[row * PAIRS + column * 2u] = packHalf2x16(value.xy);
        shared_value[row * PAIRS + column * 2u + 1u] = packHalf2x16(value.zw);
    }
}

void main()
{
    const uint lane = gl_SubgroupInvocationID;
    const uint subgroup = gl_SubgroupID;
    const uint head = gl_WorkGroupID.y;
    const uint query_base_row = gl_WorkGroupID.x * M;
    if (head >= p.head_count || lane >= 32u)
        return;

    const uint heads_per_group = p.head_count / p.key_value_head_count;
    const uint key_value_head = head / heads_per_group;
    const uint query_base = head * p.query_cstep;
    const uint key_base = key_value_head * p.key_cstep;
    const uint value_base = key_value_head * p.value_cstep;

    // Stage the query tile as fp16 pairs; a partial tile is zero filled and its
    // rows stay masked out below.
    for (uint index = gl_LocalInvocationIndex; index < M * 16u; index += 256u)
    {
        const uint row = index / 16u;
        const uint column = index % 16u;
        const uint global_row = query_base_row + row;
        vec4 query = vec4(0.0);
        if (global_row < p.query_count)
            query = query_data[query_base / 4u + (global_row * D + column * 4u) / 4u];
        shared_query[row * PAIRS + column * 2u] = packHalf2x16(query.xy);
        shared_query[row * PAIRS + column * 2u + 1u] = packHalf2x16(query.zw);
    }
    barrier();

    float accumulator_even[ROWS];
    float accumulator_odd[ROWS];
    float running_max[ROWS];
    float running_sum[ROWS];
    [[unroll]] for (uint r = 0u; r < ROWS; ++r)
    {
        accumulator_even[r] = 0.0;
        accumulator_odd[r] = 0.0;
        running_max[r] = -3.402823466e+38;
        running_sum[r] = 0.0;
    }

    const uint last_query_row = min(query_base_row + M, p.query_count);
    const uint query_maximum_position = p.position_offset + last_query_row - 1u;
    const uint query_minimum_position = p.position_offset + query_base_row;

    for (uint key_offset = 0u; key_offset < p.destination_count; key_offset += N)
    {
        // Causal and sliding-window bounds prune whole tiles before loading.
        const uint first_key_position = p.cache_start + key_offset;
        if (first_key_position > query_maximum_position)
            break;
        const uint last_key_position = p.cache_start + key_offset + N - 1u;
        if (p.sliding_window != 0u && last_key_position + p.sliding_window <= query_minimum_position)
            continue;

        load_tile(key_base, value_base, key_offset);
        barrier();

        [[unroll]] for (uint r = 0u; r < ROWS; ++r)
        {
            const uint row = subgroup * ROWS + r;
            const uint global_row = query_base_row + row;
            const uint query_position = p.position_offset + global_row;
            const bool row_valid = global_row < p.query_count;

            float score_low = 0.0;
            float score_high = 0.0;
            [[unroll]] for (uint pair = 0u; pair < PAIRS; ++pair)
            {
                const vec2 query = unpackHalf2x16(shared_query[row * PAIRS + pair]);
                const vec2 key_low = unpackHalf2x16(shared_key[pair * N + lane]);
                const vec2 key_high = unpackHalf2x16(shared_key[pair * N + lane + 32u]);
                score_low += dot(query, key_low);
                score_high += dot(query, key_high);
            }

            const uint key_low_index = key_offset + lane;
            const uint key_high_index = key_offset + lane + 32u;
            const uint key_low_position = p.cache_start + key_low_index;
            const uint key_high_position = p.cache_start + key_high_index;
            const bool low_masked = !row_valid || key_low_index >= p.destination_count
                                    || key_low_position > query_position
                                    || (p.sliding_window != 0u && key_low_position + p.sliding_window <= query_position);
            const bool high_masked = !row_valid || key_high_index >= p.destination_count
                                     || key_high_position > query_position
                                     || (p.sliding_window != 0u && key_high_position + p.sliding_window <= query_position);
            score_low = low_masked ? -3.402823466e+38 : score_low * p.scale;
            score_high = high_masked ? -3.402823466e+38 : score_high * p.scale;

            const float tile_maximum = max(subgroupMax(score_low), subgroupMax(score_high));
            const float next_maximum = max(running_max[r], tile_maximum);
            const float correction = running_sum[r] == 0.0 ? 0.0 : exp(running_max[r] - next_maximum);
            const float weight_low = low_masked ? 0.0 : exp(score_low - next_maximum);
            const float weight_high = high_masked ? 0.0 : exp(score_high - next_maximum);
            running_sum[r] = running_sum[r] * correction + subgroupAdd(weight_low + weight_high);
            running_max[r] = next_maximum;
            accumulator_even[r] *= correction;
            accumulator_odd[r] *= correction;
            shared_weights[subgroup * N + lane] = weight_low;
            shared_weights[subgroup * N + lane + 32u] = weight_high;
            barrier();

            float numerator_even = 0.0;
            float numerator_odd = 0.0;
            [[unroll]] for (uint key_index = 0u; key_index < N; ++key_index)
            {
                const float weight = shared_weights[subgroup * N + key_index];
                const vec2 value = unpackHalf2x16(shared_value[key_index * PAIRS + lane]);
                numerator_even += weight * value.x;
                numerator_odd += weight * value.y;
            }
            accumulator_even[r] += numerator_even;
            accumulator_odd[r] += numerator_odd;
            // The next row reuses this subgroup's weight plane.
            barrier();
        }
        barrier();
    }

    [[unroll]] for (uint r = 0u; r < ROWS; ++r)
    {
        const uint row = subgroup * ROWS + r;
        const uint global_row = query_base_row + row;
        if (global_row >= p.query_count)
            continue;
        const float inverse = running_sum[r] > 0.0 ? 1.0 / running_sum[r] : 0.0;
        output_data[(global_row * p.output_columns + head * D + lane * 2u)] = accumulator_even[r] * inverse;
        output_data[(global_row * p.output_columns + head * D + lane * 2u + 1u)] = accumulator_odd[r] * inverse;
    }
}
