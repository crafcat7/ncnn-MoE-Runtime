#version 450

layout(binding = 0) readonly buffer source_key_blob
{
    sfp source_key_data[];
};
layout(binding = 1) readonly buffer source_value_blob
{
    sfp source_value_data[];
};
layout(binding = 2) buffer destination_key_blob
{
    sfp destination_key_data[];
};
layout(binding = 3) buffer destination_value_blob
{
    sfp destination_value_data[];
};
// Bindings 4/5 read the source or write the FP32 destination during BF16 widening.
layout(binding = 4) buffer key_float_alias_blob
{
    float key_float_data[];
};
layout(binding = 5) buffer value_float_alias_blob
{
    float value_float_data[];
};

layout(push_constant) uniform parameter
{
    uint width;
    uint rows;
    uint channels;
    uint source_cstep;
    uint destination_cstep;
    uint capacity;
    uint destination_start;
    uint round_kv;
    uint source_fp32;
    uint source_start;
    uint copy_only;
    uint destination_fp32;
}
p;

float round_bf16(float value)
{
    const uint bits = floatBitsToUint(value);
    return uintBitsToFloat((bits + 0x7fffu + ((bits >> 16u) & 1u)) & 0xffff0000u);
}

void main()
{
    const uint column = gl_GlobalInvocationID.x;
    const uint row = gl_GlobalInvocationID.y;
    const uint channel = gl_GlobalInvocationID.z;
    if (column >= p.width || row >= p.rows || channel >= p.channels)
        return;

    const uint source_index = channel * p.source_cstep + (p.source_start + row) * p.width + column;
    const uint destination_row = p.copy_only != 0u ? row : (p.destination_start + row) % p.capacity;
    const uint destination_index = channel * p.destination_cstep + destination_row * p.width + column;
    if (p.copy_only != 0u && p.destination_fp32 == 0u)
    {
        buffer_cp1(destination_key_data, destination_index, source_key_data, source_index);
        buffer_cp1(destination_value_data, destination_index, source_value_data, source_index);
        return;
    }

    float source_key;
    float source_value;
    if (p.source_fp32 != 0u)
    {
        source_key = key_float_data[source_index];
        source_value = value_float_data[source_index];
    }
    else
    {
        source_key = buffer_ld1(source_key_data, source_index);
        source_value = buffer_ld1(source_value_data, source_index);
    }
    const float key = p.round_kv != 0u ? round_bf16(source_key) : source_key;
    const float value = p.round_kv != 0u ? round_bf16(source_value) : source_value;
    if (p.copy_only != 0u)
    {
        key_float_data[destination_index] = key;
        value_float_data[destination_index] = value;
        return;
    }
    const uint duplicate_index = destination_index + p.capacity * p.width;
    buffer_st1(destination_key_data, destination_index, key);
    buffer_st1(destination_key_data, duplicate_index, key);
    buffer_st1(destination_value_data, destination_index, value);
    buffer_st1(destination_value_data, duplicate_index, value);
}
