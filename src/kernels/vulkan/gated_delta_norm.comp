#version 450

// Per-head RMS norm and output gate for the gated delta rule. One workgroup owns
// one (value head, token) pair so the reduction spans all value columns of that
// head while tokens spread across the grid: the reduction is per token, so the
// token loop this kernel used to run serially bought nothing but barriers.

// The token index comes from gl_WorkGroupID.y, which is only equal to the token
// when local_size_y is 1.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer fused_input_blob
{
    float fused_input[];
};
layout(binding = 1) readonly buffer norm_weight_blob
{
    float norm_weight[];
};
layout(binding = 2) buffer output_blob
{
    float output_data[];
};

layout(push_constant) uniform parameter
{
    uint convolution_size;
    uint value_size;
    uint fused_columns;
    uint head_count;
    uint kv_head_count;
    uint head_dimension;
    uint value_head_dimension;
    uint kernel_size;
    uint token_count;
    float norm_epsilon;
    uint sigmoid_gate;
    uint gate_channels;
    float lower_bound;
}
p;

float sigmoid(float value)
{
    if (value >= 0.0)
        return 1.0 / (1.0 + exp(-value));
    const float exponential = exp(value);
    return exponential / (1.0 + exponential);
}

shared float partial_sum[128];

void main()
{
    const uint lane = gl_LocalInvocationID.x;
    const uint value_head = gl_WorkGroupID.x;
    const uint token = gl_WorkGroupID.y;
    if (token >= p.token_count)
        return;
    {
        const uint input_row = token * p.fused_columns;
        const uint output_base = token * p.value_size
                                 + value_head * p.value_head_dimension;
        float square_sum = 0.0;
        for (uint value_column = lane;
             value_column < p.value_head_dimension;
             value_column += 128)
        {
            const float value = output_data[output_base + value_column];
            square_sum += value * value;
        }
        partial_sum[lane] = square_sum;
        barrier();
        for (uint stride = 64; stride > 0; stride >>= 1)
        {
            if (lane < stride)
                partial_sum[lane] += partial_sum[lane + stride];
            barrier();
        }
        const float inverse_rms = 1.0 / sqrt(partial_sum[0] / float(p.value_head_dimension) + p.norm_epsilon);
        const uint gate_base = input_row + p.convolution_size;
        for (uint value_column = lane;
             value_column < p.value_head_dimension;
             value_column += 128)
        {
            const float gate = fused_input[gate_base
                                           + value_head * p.value_head_dimension
                                           + value_column];
            output_data[output_base + value_column] *= inverse_rms
                                                       * norm_weight[value_column]
                                                       * (p.sigmoid_gate != 0 ? sigmoid(gate) : gate * sigmoid(gate));
        }
    }
}
