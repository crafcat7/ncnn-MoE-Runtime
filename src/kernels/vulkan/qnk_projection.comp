#version 450

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

layout(binding = 0) readonly buffer input_blob
{
    float input_data[];
};
layout(binding = 1) readonly buffer quantized_blob
{
    uint quantized_words[];
};
layout(binding = 2) readonly buffer bias_blob
{
    float bias_data[];
};
layout(binding = 3) writeonly buffer output_blob
{
    float output_data[];
};

layout(push_constant) uniform parameter
{
    uint input_columns;
    uint output_columns;
    uint block_count;
    uint token_count;
    uint block_bytes;
    uint qnk_type;
    uint group_size;
    uint group_count;
    uint scales_offset;
    uint zeros_offset;
    uint groups_offset;
    uint columns_offset;
    uint output_stride;
    uint output_column_offset;
    uint input_group_count;
}
p;

uint qnk_byte(uint index)
{
    const uint word = quantized_words[index >> 2];
    return (word >> ((index & 3u) * 8u)) & 255u;
}

uint qnk_u16(uint index)
{
    return qnk_byte(index) | (qnk_byte(index + 1u) << 8u);
}

uint qnk_u32(uint index)
{
    return qnk_byte(index)
           | (qnk_byte(index + 1u) << 8u)
           | (qnk_byte(index + 2u) << 16u)
           | (qnk_byte(index + 3u) << 24u);
}

float qnk_f16(uint index)
{
    return unpackHalf2x16(qnk_u16(index)).x;
}

// GGML IQ4_NL stores codebook indices rather than signed/affine INT4 codes.
const int iq4_nl_values[16] = int[16](-127, -104, -83, -65, -49, -35, -22, -10,
                                      1, 13, 25, 38, 53, 69, 89, 113);

float projection_input(uint row, uint column)
{
    const uint logical_column = p.columns_offset == 0u ? column : qnk_u32(p.columns_offset + column * 4u);
    return input_data[row + logical_column];
}

int qnk_signed_byte(uint value)
{
    return value < 128u ? int(value) : int(value) - 256;
}

void qnk_scale_min_k4(uint block, int index, out uint scale, out uint minimum)
{
    const uint scales = block + 4u;
    if (index < 4)
    {
        scale = qnk_byte(scales + uint(index)) & 63u;
        minimum = qnk_byte(scales + uint(index + 4)) & 63u;
    }
    else
    {
        scale = (qnk_byte(scales + uint(index + 4)) & 15u)
                | ((qnk_byte(scales + uint(index - 4)) >> 6u) << 4u);
        minimum = (qnk_byte(scales + uint(index + 4)) >> 4u)
                  | ((qnk_byte(scales + uint(index)) >> 6u) << 4u);
    }
}

int qnk_q3_scale(uint block, uint index)
{
    const uint first = qnk_u32(block + 96u);
    const uint second = qnk_u32(block + 100u);
    const uint temporary = qnk_u32(block + 104u);
    const uint mask1 = 0x03030303u;
    const uint mask2 = 0x0f0f0f0fu;
    const uint transformed0 = (first & mask2) | ((temporary & mask1) << 4u);
    const uint transformed1 = (second & mask2) | (((temporary >> 2u) & mask1) << 4u);
    const uint transformed2 = ((first >> 4u) & mask2) | (((temporary >> 4u) & mask1) << 4u);
    const uint transformed3 = ((second >> 4u) & mask2) | (((temporary >> 6u) & mask1) << 4u);
    const uint group = index >> 2u;
    const uint word = group == 0u   ? transformed0
                      : group == 1u ? transformed1
                      : group == 2u ? transformed2
                                    : transformed3;
    return qnk_signed_byte((word >> ((index & 3u) * 8u)) & 255u);
}

float qnk_value(uint block, uint type, uint index)
{
    if (type == 0u)
    {
        const uint super = index >> 7u;
        const uint within = index & 127u;
        const uint chunk = within >> 5u;
        const uint lane = within & 15u;
        const uint q_index = block + 16u + super * 32u + ((within & 16u) != 0u ? 16u : 0u) + lane;
        const uint scale_min = qnk_byte(block + (super << 3u) + (within >> 4u));
        const float d = qnk_f16(block + 80u);
        const float minimum = qnk_f16(block + 82u);
        const float scale = d * float(scale_min & 15u);
        const float min_value = minimum * float(scale_min >> 4u);
        return scale * float((qnk_byte(q_index) >> (chunk * 2u)) & 3u) - min_value;
    }
    if (type == 1u)
    {
        const uint super = index >> 7u;
        const uint within = index & 127u;
        const uint chunk = within >> 5u;
        const uint lane = within & 15u;
        const uint q_index = block + 32u + super * 32u + ((within & 16u) != 0u ? 16u : 0u) + lane;
        const uint high_index = block + ((within & 16u) != 0u ? 16u : 0u) + lane;
        const uint high = (qnk_byte(high_index) & (1u << (chunk + super * 4u))) != 0u ? 0u : 4u;
        const int q = int((qnk_byte(q_index) >> (chunk * 2u)) & 3u) - int(high);
        const int scale = qnk_q3_scale(block, (super << 3u) + (within >> 4u)) - 32;
        return qnk_f16(block + 108u) * float(scale * q);
    }
    if (type == 2u || type == 3u)
    {
        const uint group = index >> 6u;
        const uint within = index & 63u;
        const uint part = within >> 5u;
        const uint lane = within & 31u;
        const uint scale_index = (group << 1u) + part;
        uint scale_value = 0u;
        uint min_value = 0u;
        qnk_scale_min_k4(block, int(scale_index), scale_value, min_value);
        const uint q_index = block + (type == 2u ? 16u : 48u) + group * 32u + lane;
        const uint nibble = part == 0u ? qnk_byte(q_index) & 15u : qnk_byte(q_index) >> 4u;
        uint value = nibble;
        if (type == 3u)
        {
            const uint mask = (part == 0u ? 1u : 2u) << (group * 2u);
            if ((qnk_byte(block + 16u + lane) & mask) != 0u)
                value += 16u;
        }
        return qnk_f16(block) * float(scale_value * value)
               - qnk_f16(block + 2u) * float(min_value);
    }
    if (type == 4u)
    {
        const uint super = index >> 7u;
        const uint within = index & 127u;
        const uint group = within >> 5u;
        const uint lane = within & 31u;
        const uint low_index = block + super * 64u + ((group & 1u) != 0u ? 32u : 0u) + lane;
        const uint high_index = block + 128u + super * 32u + lane;
        const uint low = (group < 2u) ? qnk_byte(low_index) & 15u : qnk_byte(low_index) >> 4u;
        const uint value = low | (((qnk_byte(high_index) >> (group * 2u)) & 3u) << 4u);
        const int signed_value = int(value) - 32;
        const int scale = qnk_signed_byte(qnk_byte(block + 192u + super * 8u + group * 2u + (lane >> 4u)));
        return qnk_f16(block + 208u) * float(scale * signed_value);
    }

    const float scale = uintBitsToFloat(qnk_u32(block));
    return scale * float(qnk_signed_byte(qnk_byte(block + 4u + index)));
}

#if !(ncnn_subgroup_basic && ncnn_subgroup_arithmetic)
shared float partial_sum[32];
#endif

void main()
{
    const uint output_column = gl_WorkGroupID.x + gl_WorkGroupID.z * gl_NumWorkGroups.x;
    const uint token = gl_WorkGroupID.y;
    const uint lane = gl_LocalInvocationID.x;
    const bool valid = output_column < p.output_columns && token < p.token_count;
    float sum = 0.0;
    if (valid && lane < 32u)
    {
        const uint group = output_column / (p.output_columns / p.input_group_count);
        const uint input_row = (token * p.input_group_count + group) * p.input_columns;
        if (p.qnk_type == 6u)
        {
            const uint matrix_row = output_column * p.block_bytes;
            for (uint column = lane; column < p.input_columns; column += 32u)
            {
                const uint group = p.groups_offset == 0u ? column / p.group_size : qnk_u32(p.groups_offset + column * 4u);
                const uint metadata = output_column * p.group_count + group;
                const float scale = uintBitsToFloat(qnk_u32(p.scales_offset + metadata * 4u));
                const uint zero = qnk_byte(p.zeros_offset + metadata);
                const uint code = (qnk_byte(matrix_row + column / 2u) >> ((column & 1u) * 4u)) & 15u;
                sum += float(int(code) - int(zero)) * scale * projection_input(input_row, column);
            }
        }
        else if (p.qnk_type == 7u || p.qnk_type == 8u)
        {
            const uint matrix_row = output_column * p.block_bytes;
            for (uint column = lane; column < p.input_columns; column += 32u)
            {
                const float weight = p.qnk_type == 7u ? uintBitsToFloat(qnk_u16(matrix_row + column * 2u) << 16u)
                                                      : uintBitsToFloat(qnk_u32(matrix_row + column * 4u));
                sum += weight * projection_input(input_row, column);
            }
        }
        else if (p.qnk_type == 9u)
        {
            // Q8_0 stores an FP16 scale and 32 signed bytes in every 34-byte
            // block. Byte addressing also handles blocks and rows that are
            // not aligned to uint or half boundaries.
            const uint matrix_row = output_column * p.block_count * p.block_bytes;
            for (uint block = 0u; block < p.block_count; ++block)
            {
                const uint block_offset = matrix_row + block * p.block_bytes;
                const float weight = qnk_f16(block_offset)
                                     * float(qnk_signed_byte(qnk_byte(block_offset + 2u + lane)));
                sum += weight * projection_input(input_row, block * 32u + lane);
            }
        }
        else if (p.qnk_type == 10u)
        {
            // Native IQ4_NL: FP16 scale followed by 16 bytes. Low nibbles
            // encode lanes 0..15, high nibbles encode lanes 16..31. The
            // 18-byte stride is deliberately read through byte addressing.
            const uint matrix_row = output_column * p.block_count * p.block_bytes;
            for (uint block = 0u; block < p.block_count; ++block)
            {
                const uint block_offset = matrix_row + block * p.block_bytes;
                const uint packed = qnk_byte(block_offset + 2u + (lane & 15u));
                const uint code = (packed >> (lane < 16u ? 0u : 4u)) & 15u;
                const float weight = qnk_f16(block_offset) * float(iq4_nl_values[code]);
                sum += weight * projection_input(input_row, block * 32u + lane);
            }
        }
        else if (p.qnk_type == 11u)
        {
            // Native Q5_1: FP16 d/m, four high-bit bytes, then 16 nibbles.
            const uint matrix_row = output_column * p.block_count * p.block_bytes;
            for (uint block = 0u; block < p.block_count; ++block)
            {
                const uint block_offset = matrix_row + block * p.block_bytes;
                const uint packed = qnk_byte(block_offset + 8u + (lane & 15u));
                const uint low = (packed >> (lane < 16u ? 0u : 4u)) & 15u;
                const uint high = (qnk_byte(block_offset + 4u + (lane >> 3u)) >> (lane & 7u)) & 1u;
                const float weight = qnk_f16(block_offset) * float(low | (high << 4u)) + qnk_f16(block_offset + 2u);
                sum += weight * projection_input(input_row, block * 32u + lane);
            }
        }
        else
        {
            const uint matrix_row = output_column * p.block_count * p.block_bytes;
            for (uint block = 0u; block < p.block_count; ++block)
            {
                const uint block_offset = matrix_row + block * p.block_bytes;
                const uint first_column = block * 256u + lane * 8u;
                for (uint offset = 0u; offset < 8u; ++offset)
                {
                    sum += qnk_value(block_offset, p.qnk_type, lane * 8u + offset)
                           * projection_input(input_row, first_column + offset);
                }
            }
        }
    }
#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
    const float reduced_sum = subgroupAdd(sum);
    if (valid && lane == 0u)
        output_data[token * p.output_stride + p.output_column_offset + output_column] = reduced_sum + bias_data[output_column];
#else
    if (lane < 32u)
        partial_sum[lane] = sum;
    barrier();
    for (uint stride = 16u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
            partial_sum[lane] += partial_sum[lane + stride];
        barrier();
    }
    if (valid && lane == 0u)
        output_data[token * p.output_stride + p.output_column_offset + output_column] = partial_sum[0] + bias_data[output_column];
#endif
}
