#version 450

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

// Query/key L2 norm for the gated delta rule. One 128-thread workgroup owns
// one (key head, token) pair. Uses subgroup reductions (1 barrier instead of 7)
// when subgroup arithmetic is available.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer fused_input_blob
{
    float fused_input[];
};

layout(push_constant) uniform parameter
{
    uint convolution_size;
    uint value_size;
    uint fused_columns;
    uint head_count;
    uint kv_head_count;
    uint head_dimension;
    uint value_head_dimension;
    uint kernel_size;
    uint token_count;
    float norm_epsilon;
    uint sigmoid_gate;
    uint gate_channels;
    float lower_bound;
    uint conv_stride;
}
p;

shared float query_sum[128];
shared float key_sum[128];

void main()
{
    const uint lane = gl_LocalInvocationID.x;
    const uint key_head = gl_WorkGroupID.x;
    const uint token = gl_WorkGroupID.y;
    if (token >= p.token_count)
        return;
    const uint key_size = p.kv_head_count * p.head_dimension;
    const bool valid = lane < p.head_dimension;

    const uint input_row = token * p.conv_stride;
    const uint query_base = input_row + key_head * p.head_dimension;
    const uint key_base = input_row + key_size + key_head * p.head_dimension;

    const float query = valid ? fused_input[query_base + lane] : 0.0;
    const float key = valid ? fused_input[key_base + lane] : 0.0;
    float q_sq = query * query;
    float k_sq = key * key;

    float query_inverse;
    float key_inverse;
#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
    q_sq = subgroupAdd(q_sq);
    k_sq = subgroupAdd(k_sq);
    if (gl_SubgroupInvocationID == 0u)
    {
        query_sum[gl_SubgroupID] = q_sq;
        key_sum[gl_SubgroupID] = k_sq;
    }
    barrier();
    float q_tot = 0.0;
    float k_tot = 0.0;
    for (uint s = 0u; s < gl_NumSubgroups; ++s)
    {
        q_tot += query_sum[s];
        k_tot += key_sum[s];
    }
    query_inverse = inversesqrt(q_tot + 1e-6);
    key_inverse = inversesqrt(k_tot + 1e-6);
#else
    query_sum[lane] = q_sq;
    key_sum[lane] = k_sq;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
        {
            query_sum[lane] += query_sum[lane + stride];
            key_sum[lane] += key_sum[lane + stride];
        }
        barrier();
    }
    query_inverse = inversesqrt(query_sum[0] + 1e-6);
    key_inverse = inversesqrt(key_sum[0] + 1e-6);
#endif
    if (valid)
    {
        fused_input[query_base + lane] = query * query_inverse;
        fused_input[key_base + lane] = key * key_inverse;
    }
}
