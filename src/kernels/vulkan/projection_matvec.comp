#version 450

// Single-row dense projection (matvec). One workgroup owns one or two output
// rows; every lane consumes four input values and four weights per step.
// Activations and BF16 weights are read as aligned 16-byte / 8-byte vectors so
// a step costs one input load and one weight load per lane instead of four
// scalar input loads plus two weight loads.

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint weight_format = 0;
layout(constant_id = 1) const uint input_pack = 4;
layout(constant_id = 2) const uint output_pack = 4;

layout(binding = 0) readonly buffer input_blob
{ uvec4 input_vectors[]; };
layout(binding = 1) readonly buffer weight_blob
{ uvec2 weight_pairs[]; };
layout(binding = 2) readonly buffer bias_blob
{ float bias_data[]; };
layout(binding = 3) writeonly buffer output_blob
{ float output_data[]; };

layout(push_constant) uniform parameter
{
    uint input_columns;
    uint output_columns;
    uint bias_term;
}
p;

uint weight_word(uint index)
{
    const uvec2 pair = weight_pairs[index >> 1u];
    return (index & 1u) == 0u ? pair.x : pair.y;
}

float matrix_weight(uint output_column, uint input_column)
{
    if (weight_format == 1u)
    {
        const uint index = output_column * p.input_columns + input_column;
        return uintBitsToFloat(((weight_word(index >> 1u) >> ((index & 1u) * 16u)) & 65535u) << 16u);
    }
    const uint tile = (output_column / output_pack) * (p.input_columns / input_pack)
                      + input_column / input_pack;
    const uint index = tile * input_pack * output_pack
                       + (output_column % output_pack) * input_pack
                       + input_column % input_pack;
    return uintBitsToFloat(weight_word(index));
}

vec4 matrix_values(uint output_column, uint input_column)
{
    if (weight_format == 1u && (p.input_columns & 3u) == 0u && input_column + 3u < p.input_columns)
    {
        // Four consecutive BF16 weights are one aligned uvec2; the row start is
        // a multiple of four columns for every supported projection shape.
        const uint index = output_column * p.input_columns + input_column;
        const uvec2 pair = weight_pairs[index >> 2u];
        return vec4(uintBitsToFloat((pair.x & 65535u) << 16u), uintBitsToFloat(pair.x & 0xffff0000u),
                    uintBitsToFloat((pair.y & 65535u) << 16u), uintBitsToFloat(pair.y & 0xffff0000u));
    }
    if (weight_format == 0u && input_pack == 4u)
    {
        const uint tile = (output_column / output_pack) * (p.input_columns / 4u) + input_column / 4u;
        const uint index = tile * 4u * output_pack + (output_column % output_pack) * 4u;
        return uintBitsToFloat(uvec4(weight_word(index), weight_word(index + 1u),
                                     weight_word(index + 2u), weight_word(index + 3u)));
    }
    vec4 result = vec4(0.0);
    for (uint index = 0u; index < 4u; ++index)
        if (input_column + index < p.input_columns)
            result[index] = matrix_weight(output_column, input_column + index);
    return result;
}

shared vec2 partial[128];

void main()
{
    const uint outputs_per_group = weight_format == 1u ? 2u : 1u;
    const uint output_column = gl_WorkGroupID.x * outputs_per_group;
    const bool second_output = outputs_per_group == 2u && output_column + 1u < p.output_columns;
    const uint lane = gl_LocalInvocationIndex;
    float sum0 = 0.0;
    float sum1 = 0.0;
    for (uint column = lane * 4u; column < p.input_columns; column += 512u)
    {
        vec4 input_values;
        if (column + 3u < p.input_columns)
        {
            input_values = uintBitsToFloat(input_vectors[column >> 2u]);
        }
        else
        {
            const uvec4 tail = input_vectors[column >> 2u];
            input_values = vec4(0.0);
            input_values.x = uintBitsToFloat(tail.x);
            if (column + 1u < p.input_columns) input_values.y = uintBitsToFloat(tail.y);
            if (column + 2u < p.input_columns) input_values.z = uintBitsToFloat(tail.z);
        }
        if (output_column < p.output_columns)
            sum0 += dot(matrix_values(output_column, column), input_values);
        if (second_output)
            sum1 += dot(matrix_values(output_column + 1u, column), input_values);
    }
    float result = 0.0;
#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
    const vec2 reduced = subgroupAdd(vec2(sum0, sum1));
    if (gl_SubgroupInvocationID == 0u)
        partial[gl_SubgroupID] = reduced;
    barrier();
    if (lane < outputs_per_group)
        for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup)
            result += partial[subgroup][lane];
#else
    partial[lane] = vec2(sum0, sum1);
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride)
            partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane < outputs_per_group)
        result = partial[0][lane];
#endif
    const uint column = output_column + lane;
    if (lane < outputs_per_group && column < p.output_columns)
        output_data[column] = result + (p.bias_term != 0u ? bias_data[column] : 0.0);
}
