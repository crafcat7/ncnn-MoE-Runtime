#version 450

#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

layout(constant_id = 0) const uint use_subgroup_reductions = 0;

layout(binding = 0) readonly buffer input_blob
{
    float input_data[];
};
layout(binding = 1) readonly buffer weight_blob
{
    float weight_data[];
};
#ifdef NCNN_RMS_NORM_RESIDUAL_ADD
layout(binding = 3) readonly buffer branch_blob
{
    float branch_data[];
};
layout(binding = 4) buffer residual_blob
{
    float residual_data[];
};
#define NCNN_RMS_NORM_DATA residual_data
#else
#define NCNN_RMS_NORM_DATA input_data
#endif
layout(binding = 2) writeonly buffer output_blob
{
    float output_data[];
};
layout(push_constant) uniform parameter
{
    uint columns;
    uint rows;
    float epsilon;
    float weight_offset;
    uint workgroup_size;
}
p;

shared float partial[256];

void main()
{
    const uint row = gl_WorkGroupID.y;
    const uint lane = gl_LocalInvocationID.x;
    const uint row_offset = row * p.columns;
#ifdef NCNN_RMS_NORM_RESIDUAL_ADD
    for (uint column = lane * 4u; column < p.columns; column += p.workgroup_size * 4u)
    {
        precise float value0 = input_data[row_offset + column] + branch_data[row_offset + column];
        residual_data[row_offset + column] = value0;
        if (column + 1u < p.columns)
        {
            precise float value1 = input_data[row_offset + column + 1u] + branch_data[row_offset + column + 1u];
            residual_data[row_offset + column + 1u] = value1;
        }
        if (column + 2u < p.columns)
        {
            precise float value2 = input_data[row_offset + column + 2u] + branch_data[row_offset + column + 2u];
            residual_data[row_offset + column + 2u] = value2;
        }
        if (column + 3u < p.columns)
        {
            precise float value3 = input_data[row_offset + column + 3u] + branch_data[row_offset + column + 3u];
            residual_data[row_offset + column + 3u] = value3;
        }
    }
    memoryBarrierBuffer();
    barrier();
#endif
    float square_sum = 0.0;
    for (uint column = lane * 4u; column < p.columns; column += p.workgroup_size * 4u)
    {
        vec4 values = vec4(NCNN_RMS_NORM_DATA[row_offset + column], 0.0, 0.0, 0.0);
        if (column + 1u < p.columns) values.y = NCNN_RMS_NORM_DATA[row_offset + column + 1u];
        if (column + 2u < p.columns) values.z = NCNN_RMS_NORM_DATA[row_offset + column + 2u];
        if (column + 3u < p.columns) values.w = NCNN_RMS_NORM_DATA[row_offset + column + 3u];
        square_sum += dot(values, values);
    }
    float inverse_rms = 0.0;
#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic
    if (use_subgroup_reductions != 0u)
    {
        const float subgroup_sum = subgroupAdd(square_sum);
        if (gl_SubgroupInvocationID == 0u)
            partial[gl_SubgroupID] = subgroup_sum;
        barrier();
        if (gl_SubgroupID == 0u)
        {
            // Each subgroup contributes one value. A subgroup may contain 32 or
            // 64 lanes; no lane-count assumption is needed by either reduction.
            float value = 0.0;
            for (uint subgroup = gl_SubgroupInvocationID; subgroup < gl_NumSubgroups; subgroup += gl_SubgroupSize)
                value += partial[subgroup];
            const float total = subgroupAdd(value);
            if (gl_SubgroupInvocationID == 0u)
                partial[0] = inversesqrt(total / float(p.columns) + p.epsilon);
        }
        barrier();
        inverse_rms = partial[0];
    }
    else
#endif
    {
        partial[lane] = square_sum;
        barrier();
        for (uint stride = p.workgroup_size >> 1u; stride > 0u; stride >>= 1u)
        {
            if (lane < stride)
                partial[lane] += partial[lane + stride];
            barrier();
        }
        inverse_rms = inversesqrt(partial[0] / float(p.columns) + p.epsilon);
    }
    for (uint column = lane * 4u; column < p.columns; column += p.workgroup_size * 4u)
        for (uint item = 0u; item < 4u && column + item < p.columns; ++item)
            output_data[row_offset + column + item] = NCNN_RMS_NORM_DATA[row_offset + column + item]
                                                      * inverse_rms * (weight_data[column + item] + p.weight_offset);
}
