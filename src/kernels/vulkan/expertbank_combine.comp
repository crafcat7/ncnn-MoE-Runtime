#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0) readonly buffer input_blob
{ float input_data[]; };
layout(binding = 1) readonly buffer selected_blob
{ float selected[]; };
layout(binding = 2) writeonly buffer output_blob
{ float output_data[]; };
layout(binding = 3) buffer validation_blob
{ uint validation[]; };
layout(binding = 4) readonly buffer shared_blob
{ float shared_data[]; };
layout(binding = 5) readonly buffer residual_blob
{ float residual_data[]; };

layout(push_constant) uniform parameter
{
    uint columns;
    uint rows;
    uint top_k;
    uint expert_count;
    uint has_shared;
    uint has_residual;
}
p;

shared uint row_invalid;
shared uint route_order[64];

void main()
{
    const uint row = gl_WorkGroupID.y;
    const uint lane = gl_LocalInvocationIndex;
    const uint base = row * (2u * p.top_k + 1u);
    if (lane == 0u) row_invalid = selected[base + 2u * p.top_k] == 0.0 ? 0u : 1u;
    barrier();
    if (lane < p.top_k)
    {
        const float id = selected[base + lane];
        const float weight = selected[base + p.top_k + lane];
        bool valid = !isnan(id) && !isinf(id) && id >= 0.0 && id < float(p.expert_count) && floor(id) == id
                     && !isnan(weight) && !isinf(weight) && weight >= 0.0;
        uint rank = 0u;
        for (uint route = 0u; route < p.top_k; ++route)
        {
            const float other = selected[base + route];
            if (route != lane && other == id) valid = false;
            rank += uint(other < id);
        }
        if (valid)
            route_order[rank] = lane;
        else
            atomicOr(row_invalid, 1u);
    }
    barrier();
    if (row_invalid != 0u && lane == 0u) atomicOr(validation[0], 1u);
    const uint column = gl_GlobalInvocationID.x;
    const uint index = row * p.columns + column;
    if (row < p.rows && column < p.columns)
    {
        precise float sum = 0.0;
        if (row_invalid == 0u)
        {
            for (uint rank = 0u; rank < p.top_k; ++rank)
            {
                const uint route = route_order[rank];
                precise float product = selected[base + p.top_k + route] * input_data[(row * p.top_k + route) * p.columns + column];
                sum = sum + product;
            }
            if (p.has_shared != 0u) sum = sum + shared_data[index];
            if (p.has_residual != 0u) sum = residual_data[index] + sum;
        }
        output_data[index] = sum;
    }
}
